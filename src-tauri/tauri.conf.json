{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fast Box",
  "version": "0.1.0",
  "identifier": "com.fastbox.app",
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "../fast-box-registry/**/*"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Fast Box",
        "width": 960,
        "height": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  }
}
